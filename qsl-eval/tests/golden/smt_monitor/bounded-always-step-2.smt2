(set-logic QF_LIA)
(declare-const s0.c.value Int)
(declare-const m0 Int)
(declare-const s1.c.value Int)
(declare-const m1 Int)
(declare-const s2.c.value Int)
(declare-const m2 Int)
(assert (and (<= 0 s0.c.value) (<= s0.c.value 3)))
(assert (and (<= 0 m0) (<= m0 3)))
(assert (and (<= 0 s1.c.value) (<= s1.c.value 3)))
(assert (and (<= 0 m1) (<= m1 3)))
(assert (and (<= 0 s2.c.value) (<= s2.c.value 3)))
(assert (and (<= 0 m2) (<= m2 3)))
(assert (or (and (< s0.c.value 3) (= (- s1.c.value s0.c.value) 1)) (= s1.c.value s0.c.value)))
(assert (or (and (< s1.c.value 3) (= (- s2.c.value s1.c.value) 1)) (= s2.c.value s1.c.value)))
(assert (=> (and (= m0 0) (not (<= s1.c.value 3))) (= m1 1)))
(assert (=> (and (= m0 0) (<= s1.c.value 3)) (= m1 2)))
(assert (=> (and (= m0 1) (not (<= s1.c.value 3))) (= m1 1)))
(assert (=> (and (= m0 1) (<= s1.c.value 3)) (= m1 1)))
(assert (=> (and (= m0 2) (not (<= s1.c.value 3))) (= m1 1)))
(assert (=> (and (= m0 2) (<= s1.c.value 3)) (= m1 3)))
(assert (=> (and (= m0 3) (not (<= s1.c.value 3))) (= m1 3)))
(assert (=> (and (= m0 3) (<= s1.c.value 3)) (= m1 3)))
(assert (=> (and (= m1 0) (not (<= s2.c.value 3))) (= m2 1)))
(assert (=> (and (= m1 0) (<= s2.c.value 3)) (= m2 2)))
(assert (=> (and (= m1 1) (not (<= s2.c.value 3))) (= m2 1)))
(assert (=> (and (= m1 1) (<= s2.c.value 3)) (= m2 1)))
(assert (=> (and (= m1 2) (not (<= s2.c.value 3))) (= m2 1)))
(assert (=> (and (= m1 2) (<= s2.c.value 3)) (= m2 3)))
(assert (=> (and (= m1 3) (not (<= s2.c.value 3))) (= m2 3)))
(assert (=> (and (= m1 3) (<= s2.c.value 3)) (= m2 3)))
(assert (not (and (= s1.c.value s0.c.value) (= m1 m0))))
(assert (not (and (= s2.c.value s0.c.value) (= m2 m0))))
(assert (not (and (= s2.c.value s1.c.value) (= m2 m1))))
(assert (not (= m0 1)))
(assert (not (= m1 1)))
(assert (= m2 1))
(check-sat)
