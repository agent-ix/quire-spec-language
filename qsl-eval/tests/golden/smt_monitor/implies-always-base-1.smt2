(assert (=> (and (= s0.c.value 3) (= s0.c.value 3)) (= m0 2)))
(assert (=> (and (= m0 0) (and (not (= s1.c.value 3)) (not (= s1.c.value 3)))) (= m1 0)))
(assert (=> (and (= m0 0) (and (= s1.c.value 3) (not (= s1.c.value 3)))) (= m1 1)))
(assert (=> (and (= m0 0) (and (not (= s1.c.value 3)) (= s1.c.value 3))) (= m1 0)))
(assert (=> (and (= m0 0) (and (= s1.c.value 3) (= s1.c.value 3))) (= m1 2)))
(assert (=> (and (= m0 1) (and (not (= s1.c.value 3)) (not (= s1.c.value 3)))) (= m1 1)))
(assert (=> (and (= m0 1) (and (= s1.c.value 3) (not (= s1.c.value 3)))) (= m1 1)))
(assert (=> (and (= m0 1) (and (not (= s1.c.value 3)) (= s1.c.value 3))) (= m1 1)))
(assert (=> (and (= m0 1) (and (= s1.c.value 3) (= s1.c.value 3))) (= m1 1)))
(assert (=> (and (= m0 2) (and (not (= s1.c.value 3)) (not (= s1.c.value 3)))) (= m1 1)))
(assert (=> (and (= m0 2) (and (= s1.c.value 3) (not (= s1.c.value 3)))) (= m1 1)))
(assert (=> (and (= m0 2) (and (not (= s1.c.value 3)) (= s1.c.value 3))) (= m1 2)))
