(set-logic QF_LIA)
(declare-const s0.c.value Int)
(declare-const m0 Int)
(declare-const s1.c.value Int)
(declare-const m1 Int)
(assert (and (<= 0 s0.c.value) (<= s0.c.value 3)))
(assert (and (<= 0 m0) (<= m0 3)))
(assert (and (<= 0 s1.c.value) (<= s1.c.value 3)))
(assert (and (<= 0 m1) (<= m1 3)))
(assert (= s0.c.value 0))
(assert (or (and (< s0.c.value 3) (= (- s1.c.value s0.c.value) 1)) (= s1.c.value s0.c.value)))
(assert (=> (not (<= s0.c.value 3)) (= m0 1)))
(assert (=> (<= s0.c.value 3) (= m0 2)))
(assert (=> (and (= m0 0) (not (<= s1.c.value 3))) (= m1 1)))
(assert (=> (and (= m0 0) (<= s1.c.value 3)) (= m1 2)))
(assert (=> (and (= m0 1) (not (<= s1.c.value 3))) (= m1 1)))
(assert (=> (and (= m0 1) (<= s1.c.value 3)) (= m1 1)))
(assert (=> (and (= m0 2) (not (<= s1.c.value 3))) (= m1 1)))
(assert (=> (and (= m0 2) (<= s1.c.value 3)) (= m1 3)))
(assert (=> (and (= m0 3) (not (<= s1.c.value 3))) (= m1 3)))
(assert (=> (and (= m0 3) (<= s1.c.value 3)) (= m1 3)))
(assert (or (= m0 1) (= m1 1)))
(check-sat)
