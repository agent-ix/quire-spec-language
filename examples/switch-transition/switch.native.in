// Boolean Switch transition source (FR-105-AC-13); template: the model digest is derived at emit time.
language "ix:native" edition "1-draft";
profile v = "quire.value.complete/v1";
profile p = "quire.protocol.finite-global/v1";
model M = "test/orders" version "1" digest "sha256-jcs:{model_digest}";
post Q1 using v on M::Switch::set { self.on }

