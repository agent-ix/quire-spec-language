language "ix:native" edition "1-draft";
profile v = "quire.value.complete/v1";
profile t0 = "quire.temporal.infinite-trace/v1";
model M = "test/counter-step";
pre CanInc using v on M::Counter::inc { self.value < 3 }
post Inc using v on M::Counter::inc { self.value - pre(self.value) = 1 }
temporal P using t0 over (c: M::Counter) clock "model-steps" on origin { always holds(c.value < 2) }
