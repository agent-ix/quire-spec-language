{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quire:value-compound-unit:v1",
  "title": "Evaluator-owned complete-V1 compound-unit identity preimage",
  "type": "object",
  "required": ["version", "terms"],
  "properties": {
    "version": {"const": "quire.value.compound-unit/v1"},
    "terms": {"type": "array", "items": {"$ref": "#/$defs/UnitTerm"}}
  },
  "additionalProperties": false,
  "$defs": {
    "HexDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "NodeId": {"type": "object", "required": ["domain", "digest"], "properties": {"domain": {"const": "quire.checked-semantic-node/v1"}, "digest": {"$ref": "#/$defs/HexDigest"}}, "additionalProperties": false},
    "IntegerString": {"type": "string", "pattern": "^(0|-?[1-9][0-9]*)$"},
    "UnitTerm": {"type": "object", "required": ["unit_node_id", "exponent"], "properties": {"unit_node_id": {"$ref": "#/$defs/NodeId"}, "exponent": {"$ref": "#/$defs/IntegerString"}}, "additionalProperties": false}
  }
}
