{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quire:checked-semantic-node-preimage:v1",
  "title": "Complete-V1 admitted nominal and application-bearing semantic node identity preimages",
  "oneOf": [
    {"$ref": "#/$defs/EnumDeclaration"},
    {"$ref": "#/$defs/EnumMember"},
    {"$ref": "#/$defs/Dimension"},
    {"$ref": "#/$defs/Unit"},
    {"$ref": "#/$defs/ApplicationNode"}
  ],
  "$defs": {
    "Nonempty": {"type": "string", "minLength": 1},
    "HexDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Identifier": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "QualifiedName": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Identifier"}},
    "Declaration": {"type": "object", "required": ["qualified_name"], "properties": {"qualified_name": {"$ref": "#/$defs/QualifiedName"}}, "additionalProperties": false},
    "SourceOwner": {"type": "object", "required": ["kind", "authority", "identity"], "properties": {"kind": {"const": "source"}, "authority": {"$ref": "#/$defs/Nonempty"}, "identity": {"$ref": "#/$defs/Nonempty"}}, "additionalProperties": false},
    "DefinitionOwner": {"type": "object", "required": ["kind", "authority", "identity"], "properties": {"kind": {"const": "definition"}, "authority": {"$ref": "#/$defs/Nonempty"}, "identity": {"$ref": "#/$defs/Nonempty"}}, "additionalProperties": false},
    "ModelOwner": {"type": "object", "required": ["kind", "identity", "node"], "properties": {"kind": {"const": "model"}, "identity": {"$ref": "#/$defs/Nonempty"}, "node": {"$ref": "#/$defs/Nonempty"}}, "additionalProperties": false},
    "Owner": {"oneOf": [{"$ref": "#/$defs/SourceOwner"}, {"$ref": "#/$defs/DefinitionOwner"}, {"$ref": "#/$defs/ModelOwner"}]},
    "NodeId": {"type": "object", "required": ["domain", "digest"], "properties": {"domain": {"const": "quire.checked-semantic-node/v1"}, "digest": {"$ref": "#/$defs/HexDigest"}}, "additionalProperties": false},
    "IntegerString": {"type": "string", "pattern": "^(0|-?[1-9][0-9]*)$"},
    "PositiveIntegerString": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "Rational": {"type": "object", "required": ["numerator", "denominator"], "properties": {"numerator": {"$ref": "#/$defs/IntegerString"}, "denominator": {"$ref": "#/$defs/PositiveIntegerString"}}, "additionalProperties": false},
    "DimensionTerm": {"type": "object", "required": ["dimension_node_id", "exponent"], "properties": {"dimension_node_id": {"$ref": "#/$defs/NodeId"}, "exponent": {"$ref": "#/$defs/IntegerString"}}, "additionalProperties": false},
    "Revision": {"type": "object", "required": ["namespace", "value"], "properties": {"namespace": {"$ref": "#/$defs/Nonempty"}, "value": {"$ref": "#/$defs/Nonempty"}}, "additionalProperties": false},
    "DefinitionRef": {"type": "object", "required": ["authority", "identity", "revision", "digest_domain", "digest"], "properties": {"authority": {"$ref": "#/$defs/Nonempty"}, "identity": {"$ref": "#/$defs/Nonempty"}, "revision": {"$ref": "#/$defs/Revision"}, "digest_domain": {"const": "quire.definition.bytes/v1"}, "digest": {"$ref": "#/$defs/HexDigest"}}, "additionalProperties": false},
    "NodeRef": {"$ref": "#/$defs/NodeId"},
    "OperationIdentity": {"enum": ["quire.op.boolean.not","quire.op.boolean.and","quire.op.boolean.or","quire.op.boolean.implies","quire.op.boolean.eq","quire.op.boolean.ne","quire.op.integer.negate","quire.op.integer.add","quire.op.integer.sub","quire.op.integer.mul","quire.op.integer.div","quire.op.integer.rem","quire.op.integer.mod","quire.op.integer.eq","quire.op.integer.ne","quire.op.integer.lt","quire.op.integer.le","quire.op.integer.gt","quire.op.integer.ge","quire.op.rational.negate","quire.op.rational.add","quire.op.rational.sub","quire.op.rational.mul","quire.op.rational.div","quire.op.rational.eq","quire.op.rational.ne","quire.op.rational.lt","quire.op.rational.le","quire.op.rational.gt","quire.op.rational.ge","quire.op.decimal.negate","quire.op.decimal.add","quire.op.decimal.sub","quire.op.decimal.mul","quire.op.decimal.div","quire.op.decimal.eq","quire.op.decimal.ne","quire.op.decimal.lt","quire.op.decimal.le","quire.op.decimal.gt","quire.op.decimal.ge","quire.op.quantity.add","quire.op.quantity.sub","quire.op.quantity.mul","quire.op.quantity.div","quire.op.quantity.pow","quire.op.quantity.eq","quire.op.quantity.ne","quire.op.quantity.lt","quire.op.quantity.le","quire.op.quantity.gt","quire.op.quantity.ge","quire.op.quantity.convert","quire.op.ieee.float32.add","quire.op.ieee.float32.sub","quire.op.ieee.float32.mul","quire.op.ieee.float32.div","quire.op.ieee.float32.sqrt","quire.op.ieee.float32.fma","quire.op.ieee.float64.add","quire.op.ieee.float64.sub","quire.op.ieee.float64.mul","quire.op.ieee.float64.div","quire.op.ieee.float64.sqrt","quire.op.ieee.float64.fma","quire.op.ieee.numeric_equal","quire.op.ieee.total_order","quire.op.ieee.bit_identical","quire.op.ieee.to_float32","quire.op.ieee.to_float64","quire.op.ieee.to_rational","quire.op.ieee.from_exact","quire.op.text.eq","quire.op.text.ne","quire.op.text.lt","quire.op.text.le","quire.op.text.gt","quire.op.text.ge","quire.op.text.size","quire.op.enum.eq","quire.op.enum.ne","quire.op.enum.lt","quire.op.enum.le","quire.op.enum.gt","quire.op.enum.ge","quire.op.structural.eq","quire.op.structural.ne","quire.op.reference.eq","quire.op.reference.ne","quire.op.reference.upcast","quire.op.numeric.convert","quire.op.numeric.convert_rounding","quire.op.numeric.narrow","quire.op.rational.narrow","quire.op.record.project","quire.op.tuple.project","quire.op.collection.index","quire.op.option.present","quire.op.option.value","quire.op.state.pre","quire.op.control.if","quire.op.control.let","quire.op.collection.sequence","quire.op.collection.set","quire.op.collection.bag","quire.op.collection.ordered_set","quire.op.collection.map","quire.op.collection.filter","quire.op.collection.flat_map","quire.op.collection.flatten","quire.op.collection.fold","quire.op.collection.reduce","quire.op.collection.count","quire.op.collection.sum.integer","quire.op.collection.sum.rational","quire.op.collection.sum.decimal","quire.op.collection.sum.float32","quire.op.collection.sum.float64","quire.op.collection.sum.quantity","quire.op.collection.size","quire.op.collection.contains","quire.op.collection.forall","quire.op.collection.exists","quire.op.collection.convert","quire.op.model.deref","quire.op.model.navigate","quire.op.model.reaches","quire.op.model.lookup","quire.op.model.all_instances","quire.op.model.dispatch_call","quire.op.function.call","quire.op.temporal.clause","quire.op.protocol.control","quire.op.state.transition","quire.op.claim.clause"]},
    "OperationLaw": {"type": "object", "required": ["role", "definition"], "properties": {"role": {"enum": ["integer_division", "ieee_profile", "text_profile", "temporal_profile", "protocol_profile"]}, "definition": {"$ref": "#/$defs/DefinitionRef"}}, "additionalProperties": false},
    "OperationMode": {"oneOf": [
      {"type": "null"},
      {"type": "object", "required": ["kind", "value"], "properties": {"kind": {"const": "rounding"}, "value": {"enum": ["exact", "toward-zero", "toward-positive", "toward-negative", "nearest-even", "nearest-away"]}}, "additionalProperties": false},
      {"type": "object", "required": ["kind", "value"], "properties": {"kind": {"const": "text_profile"}, "value": {"enum": ["unicode-scalars", "nfc", "nfd", "nfkc", "nfkd", "binary-utf8"]}}, "additionalProperties": false},
      {"type": "object", "required": ["kind", "value"], "properties": {"kind": {"const": "absence"}, "value": {"enum": ["undefined", "empty", "refused"]}}, "additionalProperties": false}
    ]},
    "OperationMember": {"oneOf": [
      {"type": "null"},
      {"type": "object", "required": ["kind", "declaration", "name"], "properties": {"kind": {"const": "field"}, "declaration": {"$ref": "#/$defs/NodeId"}, "name": {"$ref": "#/$defs/Identifier"}}, "additionalProperties": false},
      {"type": "object", "required": ["kind", "declaration", "position"], "properties": {"kind": {"const": "position"}, "declaration": {"$ref": "#/$defs/NodeId"}, "position": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
      {"type": "object", "required": ["kind", "declaration"], "properties": {"kind": {"const": "element"}, "declaration": {"$ref": "#/$defs/NodeId"}}, "additionalProperties": false},
      {"type": "object", "required": ["kind", "declaration", "name"], "properties": {"kind": {"const": "relationship_end"}, "declaration": {"$ref": "#/$defs/NodeId"}, "name": {"$ref": "#/$defs/Identifier"}}, "additionalProperties": false},
      {"type": "object", "required": ["kind", "declaration", "name"], "properties": {"kind": {"const": "operation"}, "declaration": {"$ref": "#/$defs/NodeId"}, "name": {"$ref": "#/$defs/Identifier"}}, "additionalProperties": false},
      {"type": "object", "required": ["kind", "declaration"], "properties": {"kind": {"const": "type_argument"}, "declaration": {"$ref": "#/$defs/NodeId"}}, "additionalProperties": false},
      {"type": "object", "required": ["kind", "operator"], "properties": {"kind": {"const": "profile_operator"}, "operator": {"$ref": "#/$defs/Identifier"}}, "additionalProperties": false}
    ]},
    "LeafSegment": {"type": "string", "pattern": "^(field:[A-Za-z_][A-Za-z0-9_]*|position:(0|[1-9][0-9]*)|inner)$"},
    "OperationLeaf": {"type": "object", "required": ["path", "laws", "mode"], "properties": {"path": {"type": "array", "items": {"$ref": "#/$defs/LeafSegment"}}, "laws": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/OperationLaw"}}, "mode": {"$ref": "#/$defs/OperationMode"}}, "additionalProperties": false},
    "Operation": {"type": "object", "required": ["identity", "laws", "mode", "member", "leaves"], "properties": {"identity": {"$ref": "#/$defs/OperationIdentity"}, "laws": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/OperationLaw"}}, "mode": {"$ref": "#/$defs/OperationMode"}, "member": {"$ref": "#/$defs/OperationMember"}, "leaves": {"type": "array", "items": {"$ref": "#/$defs/OperationLeaf"}}}, "additionalProperties": false},
    "PreimageTerm": {"oneOf": [
      {"type": "object", "required": ["term", "type", "value_kind", "value"], "properties": {"term": {"const": "literal"}, "type": {"$ref": "#/$defs/NodeRef"}, "value_kind": {"enum": ["boolean", "integer", "rational", "decimal", "float32_bits", "float64_bits", "text", "enum", "none"]}, "value": {"type": ["boolean", "string", "integer", "null"]}}, "additionalProperties": false},
      {"type": "object", "required": ["term", "target"], "properties": {"term": {"const": "reference"}, "target": {"$ref": "#/$defs/NodeRef"}}, "additionalProperties": false},
      {"type": "object", "required": ["term", "ordinal"], "properties": {"term": {"const": "group_reference"}, "ordinal": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
      {"type": "object", "required": ["term", "operator", "operation", "result_type", "arguments"], "properties": {"term": {"const": "application"}, "operator": {"enum": ["call", "unary", "binary", "conditional", "let", "quantify", "collection", "query", "convert", "pre", "present", "value", "deref", "reaches", "temporal", "protocol_control", "state_transition", "claim"]}, "operation": {"$ref": "#/$defs/Operation"}, "result_type": {"$ref": "#/$defs/NodeRef"}, "arguments": {"type": "array", "items": {"$ref": "#/$defs/PreimageTerm"}}}, "additionalProperties": false},
      {"type": "object", "required": ["term", "members"], "properties": {"term": {"const": "aggregate"}, "members": {"type": "array", "items": {"$ref": "#/$defs/PreimageTerm"}}}, "additionalProperties": false},
      {"type": "object", "required": ["term", "name", "value"], "properties": {"term": {"const": "binding"}, "name": {"$ref": "#/$defs/Nonempty"}, "value": {"$ref": "#/$defs/PreimageTerm"}}, "additionalProperties": false}
    ]},
    "Recursion": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["size", "ordinal"], "properties": {"size": {"type": "integer", "minimum": 1}, "ordinal": {"type": "integer", "minimum": 0}}, "additionalProperties": false}]},
    "ApplicationNode": {"type": "object", "required": ["version", "node_tag", "semantic_form", "semantic_type", "declaration", "recursion", "body"], "properties": {"version": {"const": "quire.application-node/v1"}, "node_tag": {"enum": ["scalar_type", "composite_type", "bounded_domain", "value", "expression", "function", "model", "relation", "state", "temporal", "protocol", "claim", "correspondence"]}, "semantic_form": {"$ref": "#/$defs/Nonempty"}, "semantic_type": {"$ref": "#/$defs/NodeId"}, "declaration": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Declaration"}]}, "recursion": {"$ref": "#/$defs/Recursion"}, "body": {"$ref": "#/$defs/PreimageTerm"}}, "additionalProperties": false},
    "EnumDeclaration": {"type": "object", "required": ["version", "owner", "qualified_declaration", "ordered", "members"], "properties": {"version": {"const": "quire.enum-declaration-node/v1"}, "owner": {"$ref": "#/$defs/Owner"}, "qualified_declaration": {"$ref": "#/$defs/QualifiedName"}, "ordered": {"type": "boolean"}, "members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/Identifier"}}}, "additionalProperties": false},
    "EnumMember": {"type": "object", "required": ["version", "declaration_node_id", "case"], "properties": {"version": {"const": "quire.enum-member-node/v1"}, "declaration_node_id": {"$ref": "#/$defs/NodeId"}, "case": {"$ref": "#/$defs/Identifier"}}, "additionalProperties": false},
    "Dimension": {"type": "object", "required": ["version", "owner", "qualified_declaration", "terms"], "properties": {"version": {"const": "quire.dimension-node/v1"}, "owner": {"$ref": "#/$defs/Owner"}, "qualified_declaration": {"$ref": "#/$defs/QualifiedName"}, "terms": {"type": "array", "items": {"$ref": "#/$defs/DimensionTerm"}}}, "additionalProperties": false},
    "Unit": {"type": "object", "required": ["version", "owner", "qualified_declaration", "dimension_node_id", "target_unit_node_id", "scale", "offset"], "properties": {"version": {"const": "quire.unit-node/v1"}, "owner": {"$ref": "#/$defs/Owner"}, "qualified_declaration": {"$ref": "#/$defs/QualifiedName"}, "dimension_node_id": {"$ref": "#/$defs/NodeId"}, "target_unit_node_id": {"oneOf": [{"$ref": "#/$defs/NodeId"}, {"type": "null"}]}, "scale": {"$ref": "#/$defs/Rational"}, "offset": {"$ref": "#/$defs/Rational"}}, "additionalProperties": false}
  }
}
