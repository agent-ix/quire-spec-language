{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quire:model-effective-declaration:v1",
  "title": "QSL-derived complete-V1 model identity preimages",
  "oneOf": [
    {"$ref": "#/$defs/EffectiveDeclaration"},
    {"$ref": "#/$defs/EffectiveView"},
    {"$ref": "#/$defs/ObjectUniverse"}
  ],
  "$defs": {
    "HexDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Nonempty": {"type": "string", "minLength": 1},
    "Ordinal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "EffectiveId": {"type": "object", "required": ["domain", "digest"], "properties": {"domain": {"const": "quire.model.effective-declaration/v1"}, "digest": {"$ref": "#/$defs/HexDigest"}}, "additionalProperties": false},
    "DomainPackageRef": {"type": "object", "required": ["identity", "version", "digest_domain", "digest"], "properties": {"identity": {"$ref": "#/$defs/Nonempty"}, "version": {"$ref": "#/$defs/Nonempty"}, "digest_domain": {"const": "sha256-jcs"}, "digest": {"$ref": "#/$defs/HexDigest"}}, "additionalProperties": false},
    "DeclarationKey": {"type": "object", "required": ["package", "node", "digest_domain"], "properties": {"package": {"$ref": "#/$defs/Nonempty"}, "node": {"$ref": "#/$defs/Nonempty"}, "digest_domain": {"const": "sha256-jcs"}}, "additionalProperties": false},
    "RuleRef": {"type": "object", "required": ["identity", "revision"], "properties": {"identity": {"enum": ["quire.model.normalize.qualify/v1", "quire.model.normalize.inherit/v1", "quire.model.normalize.subset/v1", "quire.model.normalize.redefine/v1"]}, "revision": {"const": "1-draft.1"}}, "additionalProperties": false},
    "Fact": {"type": "object", "required": ["ordinal", "rule", "inputs"], "properties": {"ordinal": {"$ref": "#/$defs/Ordinal"}, "rule": {"$ref": "#/$defs/RuleRef"}, "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/DeclarationKey"}}}, "additionalProperties": false},
    "EffectiveDeclaration": {"type": "object", "required": ["version", "owner_effective_type", "original", "derivation"], "properties": {"version": {"const": "quire.model.effective-declaration/v1"}, "owner_effective_type": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/EffectiveId"}]}, "original": {"$ref": "#/$defs/DeclarationKey"}, "derivation": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Fact"}}}, "additionalProperties": false},
    "ViewEntry": {"type": "object", "required": ["effective_id", "preimage"], "properties": {"effective_id": {"$ref": "#/$defs/EffectiveId"}, "preimage": {"$ref": "#/$defs/EffectiveDeclaration"}}, "additionalProperties": false},
    "EffectiveView": {"type": "object", "required": ["version", "model_selection", "rules", "declarations"], "properties": {"version": {"const": "quire.model.effective-view/v1"}, "model_selection": {"$ref": "#/$defs/DomainPackageRef"}, "rules": {"type": "object", "required": ["identity", "revision"], "properties": {"identity": {"const": "quire.model.complete.rules/v1"}, "revision": {"const": "1-draft.1"}}, "additionalProperties": false}, "declarations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ViewEntry"}}}, "additionalProperties": false},
    "ObjectUniverse": {"type": "object", "required": ["version", "model_selection", "root_types"], "properties": {"version": {"const": "quire.model.object-universe/v1"}, "model_selection": {"$ref": "#/$defs/DomainPackageRef"}, "root_types": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/EffectiveId"}}}, "additionalProperties": false}
  }
}
