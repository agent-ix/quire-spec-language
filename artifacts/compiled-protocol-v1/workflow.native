language "ix:native" edition "1-draft";
profile G = "quire.state.graph/v1" version "1-draft.3" digest "sha256:ffe0838a516bb18fa0cbebebb36f0e21323f40f2b22ca61c7d3452a86d5d2dc9";
profile T = "quire.temporal.event-position.false-extension/v1" version "1-draft.3" digest "sha256:de9236947b9caab2cf956e389c0c3f6ba5f574365c7bfca6641156eee746e9f3";
profile P = "quire.protocol.finite-global/v1" version "1-draft.4" digest "sha256:83329530cec256c4b0ddc0d31e6017fe7198da03a89725f87964b2b008afb433";
model M = "agent-ix/protocol-handoff" version "1" digest "sha256:57cc9773a8a99fdae38c0fa13579e98e3574d69469217ebe4a90dc7367dcacd4";
// SPDX-License-Identifier: AGPL-3.0-only
// Domain/activation-implied capture conjuncts exercise binding correspondence;
// the receipt/target comparisons specify the distinct recovery conditions.
protocol Flow using P over (view: M::Workflow) on origin {
    role Service on M::Workflow;
    role Provider on M::Provider;
    channel Decisions from Provider to Service carries M::Notice
        ordering unordered delivery [1,1];

    compensate Full for Main::Applied as (forwardFull: M::Workflow)
        by Service on M::Workflow::apply using T clock "full-recovery" {
        capture targetFull: M::Total = forwardFull.total;
        activate first (triggerFull: M::Notice) when { not triggerFull.ready } {
            capture activatedFull: Boolean = triggerFull.ready;
        }
        within [0,30]; attempts 3 of M::Workflow;
        retry (earlierFull: M::Workflow, laterFull: M::Workflow) {
            earlierFull.tally < 3 and laterFull.tally = earlierFull.tally + 1
            and targetFull >= 0 and not activatedFull
        };
        commit Main::Committed;
        recover (recoveredFull: M::Workflow) {
            sum<M::Total>(refundFull in recoveredFull.receipts: refundFull) = targetFull
            and not activatedFull
        };
    }

    requires temporal Due;

    compensate Partial for Main::Applied as (forwardPartial: M::Workflow)
        by Service on M::Workflow::apply using T clock "partial-recovery" {
        capture targetPartial: M::Total = forwardPartial.total;
        activate first (triggerPartial: M::Notice) when { not triggerPartial.ready } {
            capture activatedPartial: Boolean = triggerPartial.ready;
        }
        within [0,30]; attempts 3 of M::Workflow;
        retry (earlierPartial: M::Workflow, laterPartial: M::Workflow) {
            earlierPartial.tally < 3 and laterPartial.tally = earlierPartial.tally + 1
            and targetPartial >= 0 and not activatedPartial
        };
        commit never;
        recover (recoveredPartial: M::Workflow) {
            let restoredPartial = sum<M::Total>(refundPartial in recoveredPartial.receipts: refundPartial)
            in restoredPartial > 0 and restoredPartial < targetPartial and not activatedPartial
        };
    }

    run sequence Main {
        check Ready using G { Allowed(view.ratio) and deref(view.peer).ready };
        parallel Gather {
            branch left sequence Left {
                send LeftSent via Decisions as (leftSent: M::Notice) { true };
                receive LeftReply via Decisions of LeftSent as (leftReply: M::Notice) { true };
            }
            branch right sequence Right {
                send RightSent via Decisions as (rightSent: M::Notice) { true };
                receive RightReply via Decisions of RightSent as (rightReply: M::Notice) { true };
            }
        } join all [left,right];
        choice Outcome by Service visible (leftReply.ready,rightReply.ready) {
            case ready when { leftReply.ready and rightReply.ready }
                event Confirmed by Service as (confirmed: M::Notice) { true };
            case notReady when { not (leftReply.ready and rightReply.ready) }
                event Unconfirmed by Service as (unconfirmed: M::Notice) { true };
        }
        attempt Tried by Service on M::Workflow::apply contracts [BeforeApply,AfterApply]
            as (attempted: M::Notice) { attempted.ready };
        effect Applied of Main::Tried as (applied: M::Workflow) { Allowed(applied.ratio) };
        event Recovered by Service for Full as (recoveryEvent: M::Notice) { recoveryEvent.ready };
        commit Committed by Service as (committed: M::Notice) { committed.ready };
    }
    finish Closed as (closed: M::Workflow) { Allowed(closed.ratio) };
}
