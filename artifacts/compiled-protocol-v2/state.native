language "ix:native" edition "1-draft";
profile G = "quire.state.graph/v1" version "1-draft.3";
profile T = "quire.temporal.event-position.false-extension/v1" version "1-draft.3";
profile F = "quire.temporal.fixed-sample.false-extension/v1" version "1-draft.3";
profile W = "quire.temporal.timestamped-event.finite-window/v1" version "1-draft.3";
profile P = "quire.protocol.finite-global/v1" version "1-draft.4";
model M = "agent-ix/protocol-handoff";
// SPDX-License-Identifier: AGPL-3.0-only
// A bounded sum and size over the declared receipt sequence.
invariant Healthy using G on M::Workflow at current {
    Allowed(self.ratio)
    and Bounded(self.wide, self.exact)
    and size<M::Tally>(self.receipts) <= 5
    and sum<M::Total>(receipt in self.receipts: receipt) <= self.total
    and self.peer = self.peer
}

pre BeforeApply using G on M::Workflow::apply {
    // The domain-implied amount bound exercises operation-input correspondence.
    Allowed(self.ratio) and amount >= 1
}

post AfterApply using G on M::Workflow::apply {
    result and Allowed(self.ratio)
}
