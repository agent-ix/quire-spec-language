        "text": "{\n  \"license\": \"AGPL-3.0-only\",\n  \"package\": \"agent-ix/protocol-handoff\",\n  \"requirement\": \"WorkflowModel\",\n  \"revision\": 1,\n  \"scalars\": [\n    {\"name\": \"ObjectId\", \"kind\": \"text\", \"max_scalars\": 128},\n    {\"name\": \"Ratio\", \"kind\": \"rational\", \"numerator_minimum\": -1, \"numerator_maximum\": 1, \"maximum_denominator\": 2},\n    {\"name\": \"Amount\", \"kind\": \"integer\", \"minimum\": 1, \"maximum\": 20, \"unit\": \"U\"},\n    {\"name\": \"Total\", \"kind\": \"integer\", \"minimum\": 0, \"maximum\": 100, \"unit\": \"U\"},\n    {\"name\": \"Tally\", \"kind\": \"integer\", \"minimum\": 0, \"maximum\": 5},\n    {\"name\": \"Wide\", \"kind\": \"integer\", \"minimum\": -9223372036854775808, \"maximum\": 9223372036854775807},\n    {\"name\": \"Exact\", \"kind\": \"rational\", \"numerator_minimum\": -9223372036854775808, \"numerator_maximum\": 9223372036854775807, \"maximum_denominator\": 9223372036854775807}\n  ],\n  \"records\": [\n    {\"name\": \"Workflow\", \"fields\": [\n      {\"name\": \"ready\", \"type\": {\"kind\": \"boolean\"}},\n      {\"name\": \"ratio\", \"type\": {\"kind\": \"scalar\", \"name\": \"Ratio\"}},\n      {\"name\": \"peer\", \"type\": {\"kind\": \"record\", \"name\": \"WorkflowRef\"}},\n      {\"name\": \"receipts\", \"type\": {\"kind\": \"sequence\", \"maximum\": 5, \"value\": {\"kind\": \"scalar\", \"name\": \"Amount\"}}},\n      {\"name\": \"total\", \"type\": {\"kind\": \"scalar\", \"name\": \"Total\"}},\n      {\"name\": \"tally\", \"type\": {\"kind\": \"scalar\", \"name\": \"Tally\"}},\n      {\"name\": \"wide\", \"type\": {\"kind\": \"scalar\", \"name\": \"Wide\"}},\n      {\"name\": \"exact\", \"type\": {\"kind\": \"scalar\", \"name\": \"Exact\"}}\n    ]},\n    {\"name\": \"WorkflowRef\", \"fields\": [\n      {\"name\": \"id\", \"type\": {\"kind\": \"scalar\", \"name\": \"ObjectId\"}}\n    ]},\n    {\"name\": \"Notice\", \"fields\": [\n      {\"name\": \"ready\", \"type\": {\"kind\": \"boolean\"}}\n    ]}\n  ],\n  \"values\": [\n    {\"name\": \"self\", \"kind\": \"state\", \"type\": {\"kind\": \"record\", \"name\": \"Workflow\"}},\n    {\"name\": \"amount\", \"kind\": \"input\", \"type\": {\"kind\": \"scalar\", \"name\": \"Amount\"}},\n    {\"name\": \"apply_result\", \"kind\": \"input\", \"type\": {\"kind\": \"boolean\"}}\n  ],\n  \"objects\": [\n    {\"record\": \"Workflow\", \"reference\": \"WorkflowRef\", \"identity_field\": \"id\", \"universe\": \"workflows\"}\n  ],\n  \"operations\": [\n    {\"name\": \"apply\", \"context\": \"Workflow\", \"anchor\": \"apply\", \"parameters\": [\"amount\"], \"result\": \"apply_result\",\n     \"frame\": {\"fields\": [[\"Workflow\", \"total\"], [\"Workflow\", \"receipts\"], [\"Workflow\", \"tally\"]], \"created\": [], \"deleted\": []}}\n  ]\n}\n"
