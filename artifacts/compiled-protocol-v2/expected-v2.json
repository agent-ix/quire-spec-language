          },
          "text": "language \"ix:native\" edition \"1-draft\";\nprofile G = \"quire.state.graph/v1\" version \"1-draft.3\" digest \"sha256:ffe0838a516bb18fa0cbebebb36f0e21323f40f2b22ca61c7d3452a86d5d2dc9\";\nprofile T = \"quire.temporal.event-position.false-extension/v1\" version \"1-draft.3\" digest \"sha256:de9236947b9caab2cf956e389c0c3f6ba5f574365c7bfca6641156eee746e9f3\";\nprofile F = \"quire.temporal.fixed-sample.false-extension/v1\" version \"1-draft.3\" digest \"sha256:3ef8a94fd95f096d3fdf8fe57947f2f06e132e639f824505c07b8d8aacc27748\";\nprofile W = \"quire.temporal.timestamped-event.finite-window/v1\" version \"1-draft.3\" digest \"sha256:ec9fd5e7c276b41dfde230990f58a6a883c9a1c662a5bbfcd9d8002969234b84\";\nprofile P = \"quire.protocol.finite-global/v1\" version \"1-draft.4\" digest \"sha256:83329530cec256c4b0ddc0d31e6017fe7198da03a89725f87964b2b008afb433\";\nmodel M = \"agent-ix/protocol-handoff\" version \"1\" digest \"sha256:a37be55ea91c45df9061c0cfd0cb2f311a4cfc530ad6c74887161c10824781d0\";\n// SPDX-License-Identifier: AGPL-3.0-only\n// Exact selected profile/model imports are prepended by the Rust producer.\npredicate Allowed using G (ratio: M::Ratio): Boolean {\n    ratio <= rational(1,1)\n}\n\n// The signed-64 extrema and exact rationals at both component boundaries are\n// authored here so the emitted package carries them as M::Wide/M::Exact literals.\npredicate Bounded using G (wide: M::Wide, exact: M::Exact): Boolean {\n    wide >= -9223372036854775808\n    and wide <= 9223372036854775807\n    and exact <= rational(9223372036854775807, 9223372036854775806)\n    and exact >= rational(-9223372036854775808, 9223372036854775807)\n}\n"
