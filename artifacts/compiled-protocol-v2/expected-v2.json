          },
          "native": {
            "identity": "ix://agent-ix/quire-spec-language/examples/protocol-handoff/workflow",
            "revision": "1"
          },
          "path": "examples/protocol-handoff/workflow.native",
          "formal": {
            "document": "ProtocolHandoffWorkflow",
            "revision": {
              "namespace": "quire-contract-ir/source-revision",
              "value": "1"
            }
          },
          "text": "language \"ix:native\" edition \"1-draft\";\nprofile G = \"quire.state.graph/v1\" version \"1-draft.3\" digest \"sha256:ffe0838a516bb18fa0cbebebb36f0e21323f40f2b22ca61c7d3452a86d5d2dc9\";\nprofile T = \"quire.temporal.event-position.false-extension/v1\" version \"1-draft.3\" digest \"sha256:de9236947b9caab2cf956e389c0c3f6ba5f574365c7bfca6641156eee746e9f3\";\nprofile F = \"quire.temporal.fixed-sample.false-extension/v1\" version \"1-draft.3\" digest \"sha256:3ef8a94fd95f096d3fdf8fe57947f2f06e132e639f824505c07b8d8aacc27748\";\nprofile W = \"quire.temporal.timestamped-event.finite-window/v1\" version \"1-draft.3\" digest \"sha256:ec9fd5e7c276b41dfde230990f58a6a883c9a1c662a5bbfcd9d8002969234b84\";\nprofile P = \"quire.protocol.finite-global/v1\" version \"1-draft.4\" digest \"sha256:83329530cec256c4b0ddc0d31e6017fe7198da03a89725f87964b2b008afb433\";\nmodel M = \"agent-ix/protocol-handoff\" version \"1\" digest \"sha256:a37be55ea91c45df9061c0cfd0cb2f311a4cfc530ad6c74887161c10824781d0\";\n// SPDX-License-Identifier: AGPL-3.0-only\n// Domain/activation-implied capture conjuncts exercise binding correspondence;\n// the receipt/target comparisons specify the distinct recovery conditions.\nprotocol Flow using P over (view: M::Workflow) on origin {\n    role Service on M::Workflow;\n    role Provider on M::Workflow;\n    channel Decisions from Provider to Service carries M::Notice\n        ordering unordered delivery [1,1];\n\n    compensate Full for Main::Applied as (forwardFull: M::Workflow)\n        by Service on M::Workflow::apply using T clock \"full-recovery\" {\n        capture targetFull: M::Total = forwardFull.total;\n        activate first (triggerFull: M::Notice) when { not triggerFull.ready } {\n            capture activatedFull: Boolean = triggerFull.ready;\n        }\n        within [0,30]; attempts 3 of M::Workflow;\n        retry (earlierFull: M::Workflow, laterFull: M::Workflow) {\n            earlierFull.tally < 3 and laterFull.tally = earlierFull.tally + 1\n            and targetFull >= 0 and not activatedFull\n        };\n        commit Main::Committed;\n        recover (recoveredFull: M::Workflow) {\n            sum<M::Total>(refundFull in recoveredFull.receipts: refundFull) = targetFull\n            and not activatedFull\n        };\n    }\n\n    requires temporal Due;\n\n    compensate Partial for Main::Applied as (forwardPartial: M::Workflow)\n        by Service on M::Workflow::apply using T clock \"partial-recovery\" {\n        capture targetPartial: M::Total = forwardPartial.total;\n        activate first (triggerPartial: M::Notice) when { not triggerPartial.ready } {\n            capture activatedPartial: Boolean = triggerPartial.ready;\n        }\n        within [0,30]; attempts 3 of M::Workflow;\n        retry (earlierPartial: M::Workflow, laterPartial: M::Workflow) {\n            earlierPartial.tally < 3 and laterPartial.tally = earlierPartial.tally + 1\n            and targetPartial >= 0 and not activatedPartial\n        };\n        commit never;\n        recover (recoveredPartial: M::Workflow) {\n            let restoredPartial = sum<M::Total>(refundPartial in recoveredPartial.receipts: refundPartial)\n            in restoredPartial > 0 and restoredPartial < targetPartial and not activatedPartial\n        };\n    }\n\n    run sequence Main {\n        check Ready using G { Allowed(view.ratio) and deref(view.peer).ready };\n        parallel Gather {\n            branch left sequence Left {\n                send LeftSent via Decisions as (leftSent: M::Notice) { true };\n                receive LeftReply via Decisions of LeftSent as (leftReply: M::Notice) { true };\n            }\n            branch right sequence Right {\n                send RightSent via Decisions as (rightSent: M::Notice) { true };\n                receive RightReply via Decisions of RightSent as (rightReply: M::Notice) { true };\n            }\n        } join all [left,right];\n        choice Outcome by Service visible (leftReply.ready,rightReply.ready) {\n            case ready when { leftReply.ready and rightReply.ready }\n                event Confirmed by Service as (confirmed: M::Notice) { true };\n            case notReady when { not (leftReply.ready and rightReply.ready) }\n                event Unconfirmed by Service as (unconfirmed: M::Notice) { true };\n        }\n        attempt Tried by Service on M::Workflow::apply contracts [BeforeApply,AfterApply]\n            as (attempted: M::Notice) { attempted.ready };\n        effect Applied of Main::Tried as (applied: M::Workflow) { Allowed(applied.ratio) };\n        event Recovered by Service for Full as (recoveryEvent: M::Notice) { recoveryEvent.ready };\n        commit Committed by Service as (committed: M::Notice) { committed.ready };\n    }\n    finish Closed as (closed: M::Workflow) { Allowed(closed.ratio) };\n}\n"
        },
        "declarations": [
