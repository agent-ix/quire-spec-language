language "ix:native" edition "1-draft";
profile G = "quire.state.graph/v1";
profile T = "quire.temporal.event-position.false-extension/v1";
profile F = "quire.temporal.fixed-sample.false-extension/v1";
profile W = "quire.temporal.timestamped-event.finite-window/v1";
profile P = "quire.protocol.finite-global/v1";
model M = "agent-ix/protocol-handoff";
// SPDX-License-Identifier: AGPL-3.0-only
temporal Due using T over (view: M::Workflow) clock "events" on origin {
    always[0,30] holds(Allowed(view.ratio))
}

temporal DueSample using F over (view: M::Workflow) clock "sample-clock" on origin {
    always[0,30] holds(Allowed(view.ratio))
}

temporal DueTimestamp using W over (view: M::Workflow) clock "timestamp-clock" on origin {
    always[0,30] holds(Allowed(view.ratio))
}
