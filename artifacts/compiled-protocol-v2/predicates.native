model M = "agent-ix/protocol-handoff" version "1" digest "sha256:a37be55ea91c45df9061c0cfd0cb2f311a4cfc530ad6c74887161c10824781d0";
// SPDX-License-Identifier: AGPL-3.0-only
// Exact selected profile/model imports are prepended by the Rust producer.
predicate Allowed using G (ratio: M::Ratio): Boolean {
    ratio <= rational(1,1)
}

// The signed-64 extrema and exact rationals at both component boundaries are
// authored here so the emitted package carries them as M::Wide/M::Exact literals.
predicate Bounded using G (wide: M::Wide, exact: M::Exact): Boolean {
    wide >= -9223372036854775808
    and wide <= 9223372036854775807
    and exact <= rational(9223372036854775807, 9223372036854775806)
    and exact >= rational(-9223372036854775808, 9223372036854775807)
}
