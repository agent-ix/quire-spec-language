language "ix:native" edition "1-draft";
profile v = "quire.value.complete/v1" version "1-draft.2" digest "sha256:c8c7ae9fbe783286369ecc83f006190f83be4c3c8fc585766617c90f27a25b16";
type Digit = Int[0, 9];
record Point { x: Digit; y: Digit; }
function lt using v(a: Digit, b: Digit): Boolean pure { a < b }
function flag using v(b: Boolean): Boolean pure { b }
function id using v(x: Digit): Digit pure { x }
function px using v(p: Point): Digit pure { p.x }
function corner using v(p: Point): Point pure { p }
function seven using v(): Digit pure { 7 }
