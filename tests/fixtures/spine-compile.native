// Complete-V1 compile fixture (FR-027-AC-5): a record, an Integer function and
// a function with parameters. The profile digest is a placeholder.
language "ix:native" edition "1-draft";
profile v = "quire.value.complete/v1" version "1-draft.2" digest "sha256:c8c7ae9fbe783286369ecc83f006190f83be4c3c8fc585766617c90f27a25b16";
type Digit = Int[0, 9];
record Point { x: Digit; y: Digit; }
function seven using v(): Digit pure { 7 }
function px using v(p: Point): Digit pure { if p.x > p.y then p.x else p.y }
